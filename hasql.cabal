  type: exitcode-stdio-1.0
  hs-source-dirs: src/benchmarks
  main-is: Main.hs
  build-depends:
    criterion >=1.6 && <2,
    hasql,
    pqi-ffi ^>=0.1,
    pqi-native ^>=0.1,
    rerebase <2,

