    hasql:platform,
    postgresql-binary ^>=0.15,
    pqi ^>=0.1,
    text >=1 && <3,
    text-builder >=1 && <1.1,
    unordered-containers >=0.2 && <0.3,
    vector >=0.10 && <0.14,

benchmark benchmarks
