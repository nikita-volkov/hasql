  hs-source-dirs: src/platform
  exposed-modules:
    Hasql.Platform.Prelude

  other-modules:
    Hasql.Platform.Prelude.Text

  build-depends:
    base >=4.14 && <5,
    bytestring >=0.10 && <0.13,
    comonad ^>=5,
    contravariant >=1.3 && <2,
    dlist >=0.8 && <0.9 || >=1 && <2,
    hashable >=1.2 && <2,
    mtl >=2 && <3,
    profunctors >=5.1 && <6,
    scientific >=0.3 && <0.4,
    text >=1 && <3,
    text-builder >=1 && <1.1,
    time >=1.9 && <2,
    transformers >=0.5 && <0.7,
    unordered-containers >=0.2 && <0.3,
    uuid >=1.3 && <2,
    vector >=0.10 && <0.14,
    witherable >=0.5 && <0.6,

