  type: exitcode-stdio-1.0
  hs-source-dirs: src/benchmarks
  main-is: Main.hs
  build-depends:
    criterion >=1.6 && <2,
    hasql,
    pqi-ffi ^>=1.0,
    pqi-native ^>=1.0.1.9,
    rerebase <2,

